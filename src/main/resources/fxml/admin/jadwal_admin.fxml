<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projektestsiak.controllers.admin.JadwalAdminController"
            stylesheets="@/css/layouts/jadwal-admin.css"
            styleClass="jadwal-root">

    <!-- ================= HEADER ================= -->
    <top>
        <VBox spacing="10" styleClass="jadwal-header">
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Button text="Kembali ke Dashboard"
                        onAction="#handleBack"
                        styleClass="btn-outline"/>

                <Label text="Manajemen Jadwal" styleClass="h1"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Refresh"
                        onAction="#handleRefresh"
                        styleClass="btn-primary"/>
            </HBox>

            <Label text="Kelola jadwal mata pelajaran: tambah, edit, atau hapus jadwal"
                   styleClass="text-muted"/>
        </VBox>
    </top>

    <!-- ================= CENTER ================= -->
    <center>
        <SplitPane dividerPositions="0.4">

            <!-- FORM PANEL -->
            <VBox spacing="15" styleClass="card">
                <Label text="Form Jadwal" styleClass="h2"/>

                <VBox spacing="5">
                    <Label text="Mata Kuliah *"/>
                    <ComboBox fx:id="mataKuliahComboBox"
                              promptText="Pilih mata kuliah..."
                              styleClass="input-field"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Hari *"/>
                    <ComboBox fx:id="hariComboBox"
                              promptText="Pilih hari..."
                              styleClass="input-field"/>
                </VBox>

                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Jam Mulai *"/>
                        <TextField fx:id="jamMulaiField"
                                   promptText="HH:mm"
                                   styleClass="input-field"/>
                    </VBox>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Jam Selesai *"/>
                        <TextField fx:id="jamSelesaiField"
                                   promptText="HH:mm"
                                   styleClass="input-field"/>
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="Ruangan *"/>
                    <TextField fx:id="ruanganField"
                               promptText="Contoh: A101"
                               styleClass="input-field"/>
                </VBox>

                <HBox spacing="10">
                    <Button text="Tambah"
                            fx:id="btnTambah"
                            onAction="#handleTambah"
                            styleClass="btn-primary"/>

                    <Button text="Update"
                            fx:id="btnUpdate"
                            onAction="#handleUpdate"
                            styleClass="btn-outline"
                            disable="true"/>

                    <Button text="Hapus"
                            fx:id="btnHapus"
                            onAction="#handleHapus"
                            styleClass="btn-danger"
                            disable="true"/>

                    <Button text="Clear"
                            fx:id="btnClear"
                            onAction="#handleClear"
                            styleClass="btn-outline"/>
                </HBox>
            </VBox>

            <!-- TABLE PANEL -->
            <VBox spacing="10" styleClass="card">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Daftar Jadwal" styleClass="h2"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotalJadwal" styleClass="text-muted"/>
                </HBox>

                <TableView fx:id="jadwalTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colKode" text="Kode" prefWidth="80" styleClass="col-kode"/>
                        <TableColumn fx:id="colMataKuliah" text="Mata Kuliah" prefWidth="200" styleClass="col-matkul"/>
                        <TableColumn fx:id="colDosen" text="Dosen" prefWidth="150" styleClass="col-dosen"/>
                        <TableColumn fx:id="colHari" text="Hari" prefWidth="100" styleClass="col-hari"/>
                        <TableColumn fx:id="colJam" text="Jam" prefWidth="120" styleClass="col-jam"/>
                        <TableColumn fx:id="colRuangan" text="Ruangan" prefWidth="100" styleClass="col-ruangan"/>
                    </columns>
                </TableView>

            </VBox>

        </SplitPane>
    </center>

    <!-- ================= FOOTER ================= -->
    <bottom>
        <HBox alignment="CENTER" styleClass="jadwal-footer">
            <Label text="© 2024 Sistem Akademik Sekolah - Halaman Manajemen Jadwal"
                   styleClass="text-muted"/>
        </HBox>
    </bottom>

</BorderPane>
