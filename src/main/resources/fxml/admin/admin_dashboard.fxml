<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.projektestsiak.controllers.admin.AdminDashboardController"
      stylesheets="@/css/layouts/admin-dashboard.css"
      styleClass="admin-root">

    <!-- =========================
         MAIN CONTENT
    ========================== -->
    <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" styleClass="admin-main">
        <VBox spacing="28" styleClass="admin-container">
            <padding>
                <Insets top="28" right="28" bottom="28" left="28"/>
            </padding>

            <!-- HEADER CARD -->
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="admin-header-card">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="welcomeLabel" text="Selamat Datang, Administrator" styleClass="admin-title"/>
                    <Label text="Panel Administrator Sekolah" styleClass="admin-subtitle"/>
                </VBox>
                <Button text="Logout" onAction="#handleLogout" styleClass="admin-logout-btn"/>
            </HBox>

            <!-- STATS WRAPPER -->
            <HBox spacing="16" styleClass="admin-stats-wrapper">
                <VBox alignment="CENTER" styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Total User" styleClass="admin-stat-label"/>
                    <Label fx:id="quickTotalUsers" text="0" styleClass="admin-stat-value"/>
                </VBox>
                <VBox alignment="CENTER" styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Total Pelajaran" styleClass="admin-stat-label"/>
                    <Label fx:id="quickTotalCourses" text="0" styleClass="admin-stat-value"/>
                </VBox>
                <VBox alignment="CENTER" styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Login Hari Ini" styleClass="admin-stat-label"/>
                    <Label fx:id="quickTodayLogin" text="0" styleClass="admin-stat-value"/>
                </VBox>
                <VBox alignment="CENTER" styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Submission Hari Ini" styleClass="admin-stat-label"/>
                    <Label fx:id="quickTodaySubmissions" text="0" styleClass="admin-stat-value"/>
                </VBox>
            </HBox>

            <!-- MENU -->
            <VBox spacing="16">
                <Label text="Menu Administrator" styleClass="admin-section-title"/>

                <!-- RESPONSIVE GRID -->
                <FlowPane hgap="20" vgap="20" prefWrapLength="900" styleClass="admin-menu-grid">

                    <VBox styleClass="admin-menu-card">
                        <Label text="Manajemen Mata Pelajaran" styleClass="admin-menu-title"/>
                        <Button text="Kelola Course" onAction="#handleManageCourses" styleClass="btn-secondary"/>
                    </VBox>

                    <VBox styleClass="admin-menu-card">
                        <Label text="Manajemen Jadwal" styleClass="admin-menu-title"/>
                        <Button text="Kelola Jadwal" onAction="#handleManageJadwal" styleClass="btn-success"/>
                    </VBox>

                    <VBox styleClass="admin-menu-card">
                        <Label text="Validasi Pendaftaran" styleClass="admin-menu-title"/>
                        <Button text="Validasi" onAction="#handleValidasiPendaftaran" styleClass="btn-warning"/>
                    </VBox>

                    <VBox styleClass="admin-menu-card">
                        <Label text="Penilaian Tugas" styleClass="admin-menu-title"/>
                        <Button text="Beri Nilai" onAction="#handlePenilaianTugas" styleClass="btn-danger"/>
                    </VBox>

                    <VBox styleClass="admin-menu-card">
                        <Label text="Laporan Akademik" styleClass="admin-menu-title"/>
                        <Button text="Generate Laporan" onAction="#handleReports" styleClass="btn-info"/>
                    </VBox>

                </FlowPane>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- =========================
         SIDEBAR
    ========================== -->
    <VBox prefWidth="320" styleClass="admin-sidebar">

        <VBox spacing="6" styleClass="admin-sidebar-header">
            <Label text="Dashboard Statistik" styleClass="admin-sidebar-title"/>
            <Label fx:id="currentTimeLabel" text="-" styleClass="admin-sidebar-meta"/>
            <Label fx:id="lastLoginLabel" text="-" styleClass="admin-sidebar-meta"/>
        </VBox>

        <ScrollPane fitToWidth="true" styleClass="admin-sidebar-scroll">
            <VBox spacing="16">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <VBox styleClass="admin-stat-box">
                    <Label text="Statistik User" styleClass="admin-stat-title"/>
                    <Label fx:id="statsUsersLabel" text="0 Siswa" styleClass="admin-stat-value"/>
                    <HBox spacing="10">
                        <Label fx:id="statsActiveLabel" text="0 Aktif" styleClass="text-success"/>
                        <Label fx:id="statsInactiveLabel" text="0 Tidak Aktif" styleClass="text-danger"/>
                    </HBox>
                    <ProgressBar fx:id="progressUsers"/>
                </VBox>

                <VBox styleClass="admin-stat-box">
                    <Label text="Mata Pelajaran" styleClass="admin-stat-title"/>
                    <Label fx:id="statsCoursesLabel" text="0 Mata Pelajaran" styleClass="admin-stat-value"/>
                    <ProgressBar fx:id="progressCourses"/>
                </VBox>

                <VBox styleClass="admin-stat-box">
                    <Label text="Pending Validasi" styleClass="admin-stat-title"/>
                    <Label fx:id="statsPendingLabel" text="0 Pending" styleClass="admin-stat-value"/>
                    <ProgressBar fx:id="progressPending"/>
                </VBox>

                <VBox styleClass="admin-stat-box">
                    <Label text="Tugas Belum Dinilai" styleClass="admin-stat-title"/>
                    <Label fx:id="statsUngradedLabel" text="0 Belum Dinilai" styleClass="admin-stat-value"/>
                    <ProgressBar fx:id="progressUngraded"/>
                </VBox>

                <VBox styleClass="admin-quick-actions">
                    <Label text="Pembarui data" styleClass="admin-quick-title"/>
                    <Button text="Refresh Statistik" onAction="#handleRefreshStats" styleClass="btn-ghost"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
