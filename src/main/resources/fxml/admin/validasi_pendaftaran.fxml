<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projektestsiak.controllers.admin.ValidasiController"
            styleClass="page-root">

    <!-- LOAD CSS -->
    <stylesheets>
        <URL value="@/css/layouts/validasi-pendaftaran.css"/>
    </stylesheets>

    <!-- ===================== TOP: HEADER ===================== -->
    <top>
    <VBox spacing="8" styleClass="page-header" mouseTransparent="false">
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Button text="← Kembali ke Dashboard"
                    onAction="#handleBack"
                    styleClass="btn-outline"/>

            <Label text="VALIDASI PENDAFTARAN PELAJARAN TAMBAHAN"
                   styleClass="page-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Refresh"
        onAction="#handleRefresh"
        styleClass="btn-info"
        pickOnBounds="true"/>

        </HBox>

        <Label text="Validasi pendaftaran mata pelajaran tambahan dari siswa"
               styleClass="subtitle"/>
    </VBox>
</top>


    <!-- ===================== CENTER ===================== -->
    <center>
        <SplitPane dividerPositions="0.6" styleClass="content-split">

            <!-- ===== LEFT: TABLE ===== -->
            <VBox spacing="10" styleClass="card">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Daftar Pendaftaran Pending"
                           styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <TableView fx:id="pendaftaranTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSiswa" text="Siswa"/>
                        <TableColumn fx:id="colMataKuliah" text="Mata Kuliah"/>
                        <TableColumn fx:id="colSKS" text="SKS"/>
                        <TableColumn fx:id="colBiaya" text="Biaya"/>
                        <TableColumn fx:id="colStatus" text="Status"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <HBox spacing="8" styleClass="info-bar">
                    <Label text="ℹ️"/>
                    <Label text="Pilih baris untuk melihat detail dan melakukan validasi"
                           styleClass="label-muted"/>
                </HBox>
            </VBox>

            <!-- ===== RIGHT: DETAIL PANEL ===== -->
            <VBox spacing="15" styleClass="card detail-panel">

                <Label text="Detail Pendaftaran" styleClass="section-title"/>

                <VBox spacing="5">
                    <Label text="Siswa:" styleClass="label-muted"/>
                    <Label fx:id="lblDetailSiswa" text="-" styleClass="label-bold"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Mata Kuliah:" styleClass="label-muted"/>
                    <Label fx:id="lblDetailMataKuliah" text="-" styleClass="label-bold"/>
                </VBox>

                <HBox spacing="20">
                    <VBox spacing="5">
                        <Label text="SKS:" styleClass="label-muted"/>
                        <Label fx:id="lblDetailSKS" text="-" styleClass="label-bold"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Total Biaya:" styleClass="label-muted"/>
                        <Label fx:id="lblDetailBiaya" text="-" styleClass="label-bold"/>
                    </VBox>
                </HBox>

                <VBox spacing="8">
                    <Label text="Bukti Pembayaran:" styleClass="label-muted"/>
                    <ImageView fx:id="imageViewBukti"
                               fitWidth="300"
                               fitHeight="200"
                               preserveRatio="true"
                               styleClass="image-preview"/>

                    <Button fx:id="btnLihatBukti"
                            text="Lihat Bukti Pembayaran"
                            onAction="#handleLihatBukti"
                            styleClass="btn-purple"
                            disable="true"
                            prefWidth="300"/>
                </VBox>

                <HBox spacing="12">
                    <Button fx:id="btnApprove"
                            text="Setujui"
                            onAction="#handleApprove"
                            styleClass="btn-success"
                            prefWidth="140"
                            disable="true"/>

                    <Button fx:id="btnReject"
                            text="Tolak"
                            onAction="#handleReject"
                            styleClass="btn-danger"
                            prefWidth="140"
                            disable="true"/>
                </HBox>

                <Label text="* Klik 'Tolak' akan meminta alasan penolakan"
                       styleClass="label-warning"/>

            </VBox>
        </SplitPane>
    </center>

    <!-- ===================== BOTTOM ===================== -->
    <bottom>
        <HBox alignment="CENTER" styleClass="footer">
            <Label text="© 2024 Sistem Akademik Sekolah - Halaman Validasi Pendaftaran"
                   styleClass="footer-text"/>
        </HBox>
    </bottom>

</BorderPane>
