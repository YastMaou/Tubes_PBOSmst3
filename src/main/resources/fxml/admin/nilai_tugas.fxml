<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.projektestsiak.controllers.admin.NilaiController"
      stylesheets="@/css/layouts/penilaian-tugas.css"
      styleClass="page-root"
      spacing="15">

    <!-- =========================
         HEADER
    ========================== -->
    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="page-header">
        <Button text="← Kembali" onAction="#handleBack" styleClass="btn-outline"/>
        <Label text="Penilaian Tugas Siswa" styleClass="page-title"/>
    </HBox>

    <!-- =========================
         MAIN CONTENT
    ========================== -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- ===== LEFT: TABLE + TABS ===== -->
        <VBox spacing="10" prefWidth="650" HBox.hgrow="ALWAYS" styleClass="card">

            <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" styleClass="tab-pane">
                <Tab text="Belum Dinilai">
                    <VBox spacing="10" styleClass="tab-content">
                        <TableView fx:id="tableBelumDinilai">
                            <columns>
                                <TableColumn fx:id="colSiswaBelum" text="Siswa"/>
                                <TableColumn fx:id="colMataKuliahBelum" text="Mata Pelajaran"/>
                                <TableColumn fx:id="colTugasBelum" text="Tugas"/>
                                <TableColumn fx:id="colTanggalBelum" text="Tanggal Submit"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

                <Tab text="Sudah Dinilai">
                    <VBox spacing="10" styleClass="tab-content">
                        <TableView fx:id="tableSudahDinilai">
                            <columns>
                                <TableColumn fx:id="colSiswaSudah" text="Siswa"/>
                                <TableColumn fx:id="colMataKuliahSudah" text="Mata Pelajaran"/>
                                <TableColumn fx:id="colTugasSudah" text="Tugas"/>
                                <TableColumn fx:id="colNilaiSudah" text="Nilai"/>
                                <TableColumn fx:id="colTanggalSudah" text="Tanggal Submit"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>
            </TabPane>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Refresh Data" onAction="#handleRefresh" styleClass="btn-primary"/>
                <Button text="Clear Selection" onAction="#handleClear" styleClass="btn-secondary"/>
            </HBox>
        </VBox>

        <!-- ===== RIGHT: FORM PENILAIAN ===== -->
        <VBox spacing="15" prefWidth="360" styleClass="card">

            <Label text="Form Penilaian" styleClass="section-title"/>

            <!-- DETAIL TUGAS -->
            <VBox spacing="8" styleClass="detail-box">
                <Label text="Detail Tugas" styleClass="detail-title"/>

                <GridPane hgap="8" vgap="6">
                    <Label text="Siswa:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-muted"/>
                    <Label fx:id="lblDetailSiswa" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Mata Pelajaran:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-muted"/>
                    <Label fx:id="lblDetailMataKuliah" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Tugas:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="label-muted"/>
                    <Label fx:id="lblDetailTugas" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Deskripsi:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="label-muted"/>
                    <Label fx:id="lblDetailDeskripsi" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Tanggal Submit:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="label-muted"/>
                    <Label fx:id="lblDetailTanggal" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <Button fx:id="btnLihatFile" text="Lihat File Tugas"
                        onAction="#handleLihatFile" disable="true"
                        styleClass="btn-purple"/>
            </VBox>

            <!-- INPUT NILAI -->
            <GridPane hgap="10" vgap="10">
                <Label text="Nilai (0-100):" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="label-bold"/>
                <TextField fx:id="nilaiField" promptText="Contoh: 85.5"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Komentar:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="label-bold"/>
                <TextArea fx:id="komentarArea" prefRowCount="3" promptText="Masukkan komentar/feedback..."
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- ACTION BUTTONS -->
            <HBox spacing="12" alignment="CENTER">
                <Button fx:id="btnBeriNilai" text="Beri Nilai"
                        onAction="#handleBeriNilai" disable="true"
                        styleClass="btn-success"/>
                <Button fx:id="btnUpdateNilai" text="Update Nilai"
                        onAction="#handleUpdateNilai" disable="true"
                        styleClass="btn-info"/>
                <Button fx:id="btnHapusNilai" text="Hapus Nilai"
                        onAction="#handleHapusNilai" disable="true"
                        styleClass="btn-danger"/>
            </HBox>

        </VBox>
    </HBox>

</VBox>
