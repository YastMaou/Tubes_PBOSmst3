<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projektestsiak.controllers.akademik.PengumpulanTugasController"
            stylesheets="@/css/layouts/pengumpulan-tugas.css"
            styleClass="page-root">

    <!-- ================= HEADER ================= -->
    <top>
        <VBox spacing="8" styleClass="page-header">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="← Kembali"
                        onAction="#handleBack"
                        styleClass="btn-secondary"/>

                <Label text="Pengumpulan Tugas"
                       styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label text="Kumpulkan tugas sesuai mata kuliah dan tenggat waktu"
                   styleClass="subtitle"/>
        </VBox>
    </top>

    <!-- ================= CONTENT ================= -->
    <center>
        <VBox spacing="25">
            <!-- FIX: Padding harus format Insets -->
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- ===== INFO CARD ===== -->
            <VBox spacing="18" styleClass="card">

                <Label text="Informasi Tugas"
                       styleClass="section-title"/>

                <GridPane hgap="20" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="160"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Mata Kuliah:" styleClass="label-muted"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="mataKuliahLabel"
                           styleClass="value-text"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Judul Tugas:" styleClass="label-muted"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="judulLabel"
                           styleClass="value-text"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Deadline:" styleClass="label-muted"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="deadlineLabel"
                           styleClass="value-text deadline-text"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Deskripsi:" styleClass="label-muted"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextArea fx:id="deskripsiArea"
                              prefRowCount="4"
                              wrapText="true"
                              editable="false"
                              styleClass="text-area-readonly"
                              GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="File Tugas:" styleClass="label-muted"
                           GridPane.rowIndex="4" GridPane.columnIndex="0"/>

                    <HBox spacing="10"
                          GridPane.rowIndex="4" GridPane.columnIndex="1">
                        <TextField fx:id="filePathField"
                                   promptText="Pilih file tugas"
                                   styleClass="input-text"
                                   prefWidth="280"/>
                        <Button text="Browse"
                                onAction="#handleBrowseFile"
                                styleClass="btn-outline"/>
                    </HBox>

                    <HBox spacing="12"
                          GridPane.rowIndex="5" GridPane.columnIndex="1">
                        <Button text="Submit Tugas"
                                onAction="#handleSubmit"
                                styleClass="btn-primary"
                                prefWidth="160"/>
                    </HBox>
                </GridPane>

            </VBox>

        </VBox>
    </center>

</BorderPane>
