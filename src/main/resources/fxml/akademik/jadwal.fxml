<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.projektestsiak.controllers.akademik.JadwalController"
      stylesheets="@/css/layouts/jadwal-akademik.css"
      styleClass="jadwal-root"
      spacing="20">

    <!-- ===================== HEADER ===================== -->
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="page-header">

        <Button text="← Kembali"
                onAction="#handleBack"
                styleClass="btn-back"/>

        <VBox spacing="4">
            <Label text="Jadwal Akademik"
                   styleClass="page-title"/>
            <Label text="Lihat jadwal perkuliahan berdasarkan hari"
                   styleClass="subtitle"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Refresh"
                onAction="#handleRefresh"
                styleClass="btn-refresh"/>
    </HBox>

    <!-- ===================== FILTER ===================== -->
    <HBox spacing="15"
          alignment="CENTER_LEFT"
          styleClass="filter-card">

        <Label text="Filter Hari:" styleClass="label-muted"/>

        <ComboBox fx:id="hariComboBox"
                  prefWidth="160"
                  styleClass="combo-filter"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Pilih hari untuk memfilter jadwal"
               styleClass="hint-text"/>
    </HBox>

    <!-- ===================== TABLE CARD ===================== -->
    <VBox spacing="10"
          styleClass="table-card"
          VBox.vgrow="ALWAYS">

        <TableView fx:id="jadwalTable"
                   styleClass="custom-table"
                   VBox.vgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="colHari" text="Hari"/>
                <TableColumn fx:id="colJam" text="Jam"/>
                <TableColumn fx:id="colMataKuliah" text="Mata Kuliah"/>
                <TableColumn fx:id="colRuangan" text="Ruangan"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Info bar -->
        <HBox spacing="8" styleClass="info-bar">
            <Label text="ℹ"/>
            <Label text="Gunakan filter hari untuk menampilkan jadwal tertentu"/>
        </HBox>

    </VBox>

</VBox>
