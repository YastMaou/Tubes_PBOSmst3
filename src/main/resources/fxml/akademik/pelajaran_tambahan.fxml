<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.projektestsiak.controllers.akademik.PelajaranTambahanController"
      stylesheets="@/css/layouts/pelajaran-tambahan.css"
      styleClass="pt-root"
      spacing="20">

    <!-- ===================== HEADER ===================== -->
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="page-header">

        <Button text="← Kembali"
                onAction="#handleBack"
                styleClass="btn-back"/>

        <VBox spacing="4">
            <Label text="Pelajaran Tambahan"
                   styleClass="page-title"/>
            <Label text="Daftarkan mata kuliah tambahan di luar kurikulum utama"
                   styleClass="subtitle"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="totalSKSLabel"
               styleClass="total-sks-label"/>
    </HBox>

    <!-- ===================== FORM CARD ===================== -->
    <VBox spacing="15" styleClass="card">

        <Label text="Pendaftaran Pelajaran Tambahan"
               styleClass="section-title"/>

        <GridPane hgap="15" vgap="15">

            <Label text="Pilih Mata Kuliah:"
                   styleClass="label-muted"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>

            <ComboBox fx:id="mataKuliahComboBox"
                      prefWidth="300"
                      styleClass="combo-field"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="SKS:"
                   styleClass="label-muted"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>

            <Label fx:id="sksLabel"
                   text="0 SKS"
                   styleClass="label-bold"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Biaya:"
                   styleClass="label-muted"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>

            <Label fx:id="biayaLabel"
                   text="Rp 0"
                   styleClass="label-bold"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Bukti Pembayaran:"
                   styleClass="label-muted"
                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>

            <HBox spacing="10"
                  GridPane.rowIndex="3" GridPane.columnIndex="1">

                <TextField fx:id="buktiPembayaranField"
                           prefWidth="240"
                           promptText="Pilih file bukti pembayaran"
                           styleClass="text-field"/>

                <Button text="Browse"
                        onAction="#handleBrowseBukti"
                        styleClass="btn-outline"/>
            </HBox>

            <HBox spacing="12"
                  GridPane.rowIndex="4" GridPane.columnIndex="1">

                <Button text="Daftar"
                        onAction="#handleDaftar"
                        styleClass="btn-primary"/>

                <Button text="Refresh"
                        onAction="#handleRefresh"
                        styleClass="btn-secondary"/>
            </HBox>

        </GridPane>
    </VBox>

    <!-- ===================== TABLE CARD ===================== -->
    <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">

        <Label text="Mata Kuliah Terdaftar"
               styleClass="section-title"/>

        <TableView fx:id="registeredTable"
                   styleClass="custom-table"
                   VBox.vgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="colKode" text="Kode"/>
                <TableColumn fx:id="colNama" text="Nama Mata Kuliah"/>
                <TableColumn fx:id="colSKS" text="SKS"/>
                <TableColumn fx:id="colDosen" text="Dosen"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
