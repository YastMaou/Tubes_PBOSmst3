<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projektestsiak.controllers.akademik.DashboardController"
            styleClass="page-root">

    <!-- LOAD CSS -->
    <stylesheets>
        <URL value="@/css/layouts/dashboard-siswa.css"/>
    </stylesheets>

    <!-- ===================== TOP: HEADER ===================== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="page-header">
            <VBox spacing="4">
                <Label fx:id="welcomeLabel" styleClass="page-title"/>
                <Label fx:id="userInfoLabel" styleClass="subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- LOGOUT BUTTON -->
            <Button text="Logout"
                    onAction="#handleLogout"
                    styleClass="btn-danger"/>
        </HBox>
    </top>

    <!-- ===================== CENTER: CONTENT ===================== -->
    <center>
        <VBox spacing="30" alignment="CENTER" styleClass="page-content">

            <HBox spacing="25" alignment="CENTER">

                <!-- CARD: JADWAL -->
                <VBox spacing="15" alignment="CENTER" styleClass="card dashboard-card">
                    <Label text="📅" styleClass="card-icon"/>
                    <Label text="Jadwal Akademik" styleClass="card-title"/>
                    <Button text="Lihat Jadwal"
                            onAction="#handleJadwal"
                            styleClass="btn-info"/>
                </VBox>

                <!-- CARD: TUGAS -->
                <VBox spacing="15" alignment="CENTER" styleClass="card dashboard-card">
                    <Label text="📝" styleClass="card-icon"/>
                    <Label text="Tugas dan Pengumpulan" styleClass="card-title"/>
                    <Button text="Kelola Tugas"
                            onAction="#handleTugas"
                            styleClass="btn-purple"/>
                </VBox>

                <!-- CARD: PELAJARAN TAMBAHAN -->
                <VBox spacing="15" alignment="CENTER" styleClass="card dashboard-card">
                    <Label text="➕" styleClass="card-icon"/>
                    <Label text="Pelajaran Tambahan" styleClass="card-title"/>
                    <Button text="Daftar SKS"
                            onAction="#handlePelajaranTambahan"
                            styleClass="btn-warning"/>
                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>
