<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.projektestsiak.controllers.akademik.TugasController"
            stylesheets="@/css/layouts/tugas.css"
            styleClass="page-root">

    <!-- ================= HEADER ================= -->
    <top>
        <VBox spacing="8" styleClass="page-header">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="← Kembali"
                        onAction="#handleBack"
                        styleClass="btn-secondary"/>

                <Label text="Daftar Tugas"
                       styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </top>

    <!-- ================= CONTENT ================= -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- ===== ACTION BUTTONS ===== -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="Kumpulkan Tugas"
                        onAction="#handleKumpulkanTugas"
                        styleClass="btn-success"/>

                <Button text="Refresh"
                        onAction="#handleRefresh"
                        styleClass="btn-primary"/>
            </HBox>

            <!-- ===== TABLE CARD ===== -->
            <VBox spacing="10" styleClass="card">

                <TableView fx:id="tugasTable" styleClass="custom-table">
                    <columns>
                        <TableColumn fx:id="colMataKuliah" text="Mata Kuliah" prefWidth="160"/>
                        <TableColumn fx:id="colJudul" text="Judul Tugas" prefWidth="220"/>
                        <TableColumn fx:id="colDeskripsi" text="Deskripsi" prefWidth="320"/>
                        <TableColumn fx:id="colDeadline" text="Deadline" prefWidth="160"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="160"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

            </VBox>
        </VBox>
    </center>

</BorderPane>
