<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.2"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.projektestsiak.controllers.auth.LoginController"
           stylesheets="@/css/style.css"
           styleClass="auth-root">

    <!-- OVERLAY GELAP -->
    <Pane styleClass="auth-overlay"/>

    <!-- LOGIN CARD -->
    <VBox alignment="CENTER"
          spacing="20"
          maxWidth="420"
          maxHeight="560"
          prefWidth="420"
          prefHeight="560"
          styleClass="auth-card">

        <VBox alignment="CENTER" spacing="6">
            <Label text="Academic System" styleClass="auth-title"/>
            <Label text="Manajemen Pembelajaran Digital" styleClass="auth-subtitle"/>
        </VBox>

        <VBox alignment="CENTER" spacing="4">
            <Label text="Selamat datang kembali" styleClass="auth-welcome"/>
            <Label text="Masuk ke akun Anda untuk melanjutkan" styleClass="auth-description"/>
        </VBox>

        <VBox spacing="14" prefWidth="300">
            <VBox spacing="6">
                <Label text="Username" styleClass="form-label"/>
                <TextField fx:id="usernameField"
                           promptText="student@school.edu"
                           styleClass="input-field"
                           onKeyPressed="#handleKeyPress"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="form-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="••••••••"
                               styleClass="input-field"
                               onKeyPressed="#handleKeyPress"/>
            </VBox>

            <Button fx:id="loginButton"
                    text="MASUK"
                    onAction="#handleLogin"
                    styleClass="btn-primary"/>
        </VBox>

        <VBox alignment="CENTER" spacing="6">
            <Label text="© 2024 Academic System v1.0.0" styleClass="footer-text"/>
            <Label text="Sistem Manajemen Akademik Terintegrasi" styleClass="footer-text"/>
        </VBox>

    </VBox>
</StackPane>
